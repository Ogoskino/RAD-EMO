{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RAD-EMO download file manifest",
  "description": "JSON representation of the CSV file manifest; bytes is parsed as an integer.",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["relative_path", "bytes", "sha256", "modality", "data_level", "access_tier"],
    "properties": {
      "relative_path": {"type": "string", "minLength": 1, "description": "POSIX relative path, no absolute paths, backslashes or parent segments"},
      "bytes": {"type": "integer", "minimum": 0},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "modality": {"type": "string", "minLength": 1},
      "data_level": {"type": "string", "minLength": 1},
      "access_tier": {"enum": ["public_documentation", "anonymised_embargoed", "restricted"]}
    },
    "additionalProperties": false
  }
}
